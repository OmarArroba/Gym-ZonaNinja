# ══════════════════════════════════════════
#  .gitignore — Zona Ninja (sitio estático)
# ══════════════════════════════════════════

# ── Sistema Operativo ──────────────────────
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Icon?

# Windows
Thumbs.db
Thumbs.db:encdata
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
*~

# ── Editores e IDEs ───────────────────────
# VS Code
.vscode/
!.vscode/extensions.json

# JetBrains (WebStorm, etc.)
.idea/
*.iml
*.iws
*.ipr

# Sublime Text
*.tmlanguage.cache
*.tmPreferences.cache
*.stTheme.cache
*.sublime-workspace
*.sublime-project

# Vim / Neovim
*.swp
*.swo
*~
.netrwhist

# Emacs
\#*\#
.\#*

# ── Logs y archivos temporales ────────────
*.log
*.tmp
*.temp
*.bak
*.cache

# ── Node.js (por si se añade tooling futuro)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm
.yarn/
package-lock.json
yarn.lock
pnpm-lock.yaml

# ── Build outputs (por si se añade bundler)
dist/
build/
out/
.cache/
.parcel-cache/

# ── Variables de entorno (¡NUNCA subir!)
.env
.env.local
.env.*.local
.env.production

# ── Archivos de cobertura y tests
coverage/
.nyc_output/

# ── Miscelánea
*.zip
*.tar.gz
*.rar
